+    assert result["cart"]["version"] == cart["version"] + 1
+    assert client.get("/api/v1/cart").json() == result["cart"]
+    assert client.get(f"/api/v1/orders/{order['order_id']}").json() == order
+    assert client.get("/api/v1/orders").json()["items"] == [order]
