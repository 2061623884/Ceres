{
  "case_id": "R10",
  "group": "purchase",
  "scenario_family": "dish-required-selection",
  "split": "regression",
  "core": true,
  "goal": "番茄炒蛋清单到明确确认，不把调料未选说成家中已有",
  "basis": "docs/plans/ceres-next-agent-experience-spec.md; candidate ac895fd public API contracts and corresponding backend/tests; data/fixtures/demo-products.json + store-offers.json",
  "rubric": "完成所标注目标；保留当前约束，选择不等于加购；价格/商品/政策有来源；业务处理状态与实际回执一致；不重复已知信息；未执行步骤不能判通过。",
  "steps": [
    {
      "op": "turn",
      "label": "request",
      "message": "买番茄炒蛋的食材，预算50元",
      "expect": [
        {
          "kind": "ingredient_ids",
          "path": "after.guide.plan.items",
          "value": [
            "tomato",
            "egg",
            "oil",
            "salt",
            "sugar"
          ]
        },
        {
          "kind": "role_selection",
          "path": "after.guide.plan.items",
          "value": {
            "required": true,
            "pantry": false
          }
        },
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": true
        },
        {
          "kind": "max",
          "path": "after.guide.plan.selected_total_fen",
          "value": 5000
        },
        {
          "kind": "unchanged",
          "path": "after.cart",
          "before_path": "before.cart"
        },
        {
          "kind": "unchanged",
          "path": "after.orders",
          "before_path": "before.orders"
        }
      ]
    },
    {
      "op": "confirm_plan",
      "label": "confirm-dish",
      "authorized": [
        "cart"
      ],
      "expect": [
        {
          "kind": "ingredient_ids",
          "path": "after.cart.items",
          "value": [
            "tomato",
            "egg"
          ]
        },
        {
          "kind": "confirmed_selection",
          "path": "after.cart.items",
          "before_path": "before.guide.plan.items"
        },
        {
          "kind": "present",
          "path": "after.cart.items",
          "value": true
        }
      ]
    }
  ]
}
