{
  "case_id": "H02",
  "group": "purchase",
  "scenario_family": "explicit-budget-clear-same-goal",
  "split": "acceptance",
  "core": false,
  "goal": "明确取消当前预算后保留当前商品数量",
  "basis": "docs/plans/ceres-next-agent-experience-spec.md; candidate ac895fd public API contracts and corresponding backend/tests; data/fixtures/demo-products.json + store-offers.json",
  "rubric": "完成所标注目标；保留当前约束，选择不等于加购；价格/商品/政策有来源；业务处理状态与实际回执一致；不重复已知信息；未执行步骤不能判通过。",
  "steps": [
    {
      "op": "turn",
      "label": "request",
      "message": "买两罐百事可乐原味汽水330ml罐装，预算10元",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": true
        },
        {
          "kind": "quantities",
          "path": "after.guide.plan.items",
          "value": {
            "demo:cn-pepsi-original-330ml-can": 2
          }
        },
        {
          "kind": "eq",
          "path": "after.guide.plan.selected_total_fen",
          "value": 600
        }
      ]
    },
    {
      "op": "turn",
      "label": "clear-budget",
      "message": "取消预算限制，商品和数量都不变",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": true
        },
        {
          "kind": "quantities",
          "path": "after.guide.plan.items",
          "value": {
            "demo:cn-pepsi-original-330ml-can": 2
          }
        },
        {
          "kind": "eq",
          "path": "after.guide.plan.selected_total_fen",
          "value": 600
        },
        {
          "kind": "eq",
          "path": "after.guide.constraints_summary.budget_fen",
          "value": null
        }
      ]
    }
  ]
}
