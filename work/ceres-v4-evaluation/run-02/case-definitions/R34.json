{
  "case_id": "R34",
  "group": "routing",
  "scenario_family": "momo-shopping-switch-declined",
  "split": "regression",
  "core": false,
  "goal": "墨墨购物建议被拒绝后不切换",
  "basis": "docs/plans/ceres-next-agent-experience-spec.md; candidate ac895fd public API contracts and corresponding backend/tests; data/fixtures/demo-products.json + store-offers.json",
  "rubric": "完成所标注目标；保留当前约束，选择不等于加购；价格/商品/政策有来源；业务处理状态与实际回执一致；不重复已知信息；未执行步骤不能判通过。",
  "steps": [
    {
      "op": "turn",
      "label": "request",
      "message": "我想买一瓶可乐",
      "expect": [
        {
          "kind": "eq",
          "path": "route.decision",
          "value": "suggest_switch"
        },
        {
          "kind": "unchanged",
          "path": "after.cart",
          "before_path": "before.cart"
        },
        {
          "kind": "unchanged",
          "path": "after.orders",
          "before_path": "before.orders"
        }
      ]
    },
    {
      "op": "switch",
      "label": "decline-keke",
      "target_role": "keke",
      "accept": false,
      "authorized": [],
      "expect": [
        {
          "kind": "eq",
          "path": "after.opening.role",
          "value": "momo"
        }
      ]
    }
  ],
  "initial_role": "momo"
}
