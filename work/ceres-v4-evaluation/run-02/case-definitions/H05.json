{
  "case_id": "H05",
  "group": "snack",
  "scenario_family": "change-type-before-product",
  "split": "acceptance",
  "core": false,
  "goal": "尚未选品时由薯片改为饼干保留未授权状态",
  "basis": "docs/plans/ceres-next-agent-experience-spec.md; candidate ac895fd public API contracts and corresponding backend/tests; data/fixtures/demo-products.json + store-offers.json",
  "rubric": "完成所标注目标；保留当前约束，选择不等于加购；价格/商品/政策有来源；业务处理状态与实际回执一致；不重复已知信息；未执行步骤不能判通过。",
  "steps": [
    {
      "op": "turn",
      "label": "request",
      "message": "来点零食",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": false
        },
        {
          "kind": "present",
          "path": "after.guide.pending_clarifications",
          "value": true
        }
      ]
    },
    {
      "op": "select_pending_option",
      "label": "choose-type",
      "slot": "product_type",
      "label_equals": "薯片",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.product_cards",
          "value": true
        },
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": false
        }
      ]
    },
    {
      "op": "turn",
      "label": "change-type",
      "message": "还是换成饼干，只看候选",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.product_cards",
          "value": true
        },
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": false
        },
        {
          "kind": "unchanged",
          "path": "after.cart",
          "before_path": "before.cart"
        },
        {
          "kind": "unchanged",
          "path": "after.orders",
          "before_path": "before.orders"
        }
      ]
    }
  ]
}
