{
  "case_id": "H04",
  "group": "purchase",
  "scenario_family": "post-confirm-new-quantity-delta",
  "split": "acceptance",
  "core": false,
  "goal": "已购一罐后追加一罐仅新增差量",
  "basis": "docs/plans/ceres-next-agent-experience-spec.md; candidate ac895fd public API contracts and corresponding backend/tests; data/fixtures/demo-products.json + store-offers.json",
  "rubric": "完成所标注目标；保留当前约束，选择不等于加购；价格/商品/政策有来源；业务处理状态与实际回执一致；不重复已知信息；未执行步骤不能判通过。",
  "steps": [
    {
      "op": "turn",
      "label": "request",
      "message": "买一罐百事可乐原味汽水330ml罐装",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": true
        },
        {
          "kind": "quantities",
          "path": "after.guide.plan.items",
          "value": {
            "demo:cn-pepsi-original-330ml-can": 1
          }
        },
        {
          "kind": "eq",
          "path": "after.guide.plan.selected_total_fen",
          "value": 300
        }
      ]
    },
    {
      "op": "confirm_plan",
      "label": "explicit-confirm",
      "authorized": [
        "cart"
      ],
      "expect": [
        {
          "kind": "quantities",
          "path": "after.cart.items",
          "value": {
            "demo:cn-pepsi-original-330ml-can": 1
          }
        }
      ]
    },
    {
      "op": "turn",
      "label": "append",
      "message": "同样商品再追加一罐，先列清单",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": true
        },
        {
          "kind": "quantities",
          "path": "after.cart.items",
          "value": {
            "demo:cn-pepsi-original-330ml-can": 1
          }
        }
      ]
    },
    {
      "op": "confirm_plan",
      "label": "confirm-added-quantity",
      "authorized": [
        "cart"
      ],
      "expect": [
        {
          "kind": "quantities",
          "path": "after.cart.items",
          "value": {
            "demo:cn-pepsi-original-330ml-can": 2
          }
        }
      ]
    }
  ]
}
