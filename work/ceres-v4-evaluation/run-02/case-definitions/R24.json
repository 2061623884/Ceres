{
  "case_id": "R24",
  "group": "purchase",
  "scenario_family": "stop-before-confirm",
  "split": "regression",
  "core": false,
  "goal": "清单提出后用户停止采购不写购物车",
  "basis": "docs/plans/ceres-next-agent-experience-spec.md; candidate ac895fd public API contracts and corresponding backend/tests; data/fixtures/demo-products.json + store-offers.json",
  "rubric": "完成所标注目标；保留当前约束，选择不等于加购；价格/商品/政策有来源；业务处理状态与实际回执一致；不重复已知信息；未执行步骤不能判通过。",
  "steps": [
    {
      "op": "turn",
      "label": "request",
      "message": "买一瓶农夫山泉饮用水550ml瓶装",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": true
        },
        {
          "kind": "quantities",
          "path": "after.guide.plan.items",
          "value": {
            "demo:cn-nongfu-water-550ml-bottle": 1
          }
        },
        {
          "kind": "eq",
          "path": "after.guide.plan.selected_total_fen",
          "value": 200
        }
      ]
    },
    {
      "op": "turn",
      "label": "stop",
      "message": "取消这次采购，不要加购",
      "expect": [
        {
          "kind": "unchanged",
          "path": "after.cart",
          "before_path": "before.cart"
        },
        {
          "kind": "unchanged",
          "path": "after.orders",
          "before_path": "before.orders"
        },
        {
          "kind": "eq",
          "path": "after.guide.task_status",
          "value": "cancelled"
        }
      ]
    }
  ]
}
