{
  "case_id": "R01",
  "group": "snack",
  "scenario_family": "snack-type-to-confirm",
  "split": "regression",
  "core": true,
  "goal": "零食先分类，再选两包薯片并明确加购",
  "basis": "docs/plans/ceres-next-agent-experience-spec.md; candidate ac895fd public API contracts and corresponding backend/tests; data/fixtures/demo-products.json + store-offers.json",
  "rubric": "完成所标注目标；保留当前约束，选择不等于加购；价格/商品/政策有来源；业务处理状态与实际回执一致；不重复已知信息；未执行步骤不能判通过。",
  "steps": [
    {
      "op": "turn",
      "label": "request",
      "message": "来点零食",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": false
        },
        {
          "kind": "present",
          "path": "after.guide.pending_clarifications",
          "value": true
        }
      ]
    },
    {
      "op": "select_pending_option",
      "label": "choose-type",
      "slot": "product_type",
      "label_equals": "薯片",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.product_cards",
          "value": true
        },
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": false
        }
      ]
    },
    {
      "op": "turn",
      "label": "prepare",
      "message": "买两包原味薯片70克袋装",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": true
        },
        {
          "kind": "quantities",
          "path": "after.guide.plan.items",
          "value": {
            "demo:snack-original-potato-chips-70g-bag": 2
          }
        },
        {
          "kind": "eq",
          "path": "after.guide.plan.selected_total_fen",
          "value": 1180
        }
      ]
    },
    {
      "op": "confirm_plan",
      "label": "explicit-confirm",
      "authorized": [
        "cart"
      ],
      "expect": [
        {
          "kind": "quantities",
          "path": "after.cart.items",
          "value": {
            "demo:snack-original-potato-chips-70g-bag": 2
          }
        }
      ]
    }
  ]
}
