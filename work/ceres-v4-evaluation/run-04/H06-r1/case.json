{
  "case_id": "H06",
  "group": "drink",
  "scenario_family": "brand-change-with-kept-quantity",
  "split": "acceptance",
  "core": false,
  "goal": "两瓶数量保持，指定品牌从可口改为农夫水",
  "basis": "docs/plans/ceres-next-agent-experience-spec.md; candidate ac895fd public API contracts and corresponding backend/tests; data/fixtures/demo-products.json + store-offers.json",
  "rubric": "完成所标注目标；保留当前约束，选择不等于加购；价格/商品/政策有来源；业务处理状态与实际回执一致；不重复已知信息；未执行步骤不能判通过。",
  "steps": [
    {
      "op": "turn",
      "label": "request",
      "message": "买两瓶可口可乐经典原味汽水500ml瓶装",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": true
        },
        {
          "kind": "quantities",
          "path": "after.guide.plan.items",
          "value": {
            "demo:cn-coke-original-500ml-bottle": 2
          }
        },
        {
          "kind": "eq",
          "path": "after.guide.plan.selected_total_fen",
          "value": 800
        }
      ]
    },
    {
      "op": "turn",
      "label": "replace",
      "message": "改成两瓶农夫山泉饮用水550ml瓶装",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": true
        },
        {
          "kind": "quantities",
          "path": "after.guide.plan.items",
          "value": {
            "demo:cn-nongfu-water-550ml-bottle": 2
          }
        },
        {
          "kind": "eq",
          "path": "after.guide.plan.selected_total_fen",
          "value": 400
        },
        {
          "kind": "unchanged",
          "path": "after.cart",
          "before_path": "before.cart"
        },
        {
          "kind": "unchanged",
          "path": "after.orders",
          "before_path": "before.orders"
        }
      ]
    }
  ]
}
