{
  "case_id": "R17",
  "group": "aftersales",
  "scenario_family": "refund-then-buy-consented",
  "split": "regression",
  "core": true,
  "goal": "同一独立订单退款申请后同意继续采购，步骤不重放",
  "basis": "docs/plans/ceres-next-agent-experience-spec.md; candidate ac895fd public API contracts and corresponding backend/tests; data/fixtures/demo-products.json + store-offers.json",
  "rubric": "完成所标注目标；保留当前约束，选择不等于加购；价格/商品/政策有来源；业务处理状态与实际回执一致；不重复已知信息；未执行步骤不能判通过。",
  "steps": [
    {
      "op": "turn",
      "label": "request",
      "message": "订单 {{order_id}} 想申请退款，办好后再帮我买一瓶农夫山泉饮用水550ml瓶装。",
      "expect": [
        {
          "kind": "eq",
          "path": "route.decision",
          "value": "suggest_switch"
        },
        {
          "kind": "eq",
          "path": "route.target_role",
          "value": "momo"
        },
        {
          "kind": "unchanged",
          "path": "after.cart",
          "before_path": "before.cart"
        },
        {
          "kind": "unchanged",
          "path": "after.orders",
          "before_path": "before.orders"
        }
      ]
    },
    {
      "op": "switch",
      "label": "consent-momo",
      "target_role": "momo",
      "accept": true,
      "authorized": [
        "refunds"
      ],
      "expect": [
        {
          "kind": "eq",
          "path": "after.opening.role",
          "value": "momo"
        },
        {
          "kind": "length",
          "path": "after.refunds",
          "value": 1
        }
      ]
    },
    {
      "op": "switch",
      "label": "consent-keke",
      "target_role": "keke",
      "accept": true,
      "authorized": [],
      "expect": [
        {
          "kind": "eq",
          "path": "after.opening.role",
          "value": "keke"
        },
        {
          "kind": "eq",
          "path": "after.guide.plan.can_confirm",
          "value": true
        },
        {
          "kind": "quantities",
          "path": "after.guide.plan.items",
          "value": {
            "demo:cn-nongfu-water-550ml-bottle": 1
          }
        },
        {
          "kind": "fields",
          "path": "after.guide.plan.items",
          "value": {
            "selected": true
          }
        },
        {
          "kind": "eq",
          "path": "after.guide.plan.selected_total_fen",
          "value": 200
        }
      ]
    },
    {
      "op": "replay_switch",
      "label": "replay-completed-switch",
      "expect": [
        {
          "kind": "unchanged",
          "path": "after.refunds",
          "before_path": "before.refunds"
        },
        {
          "kind": "unchanged",
          "path": "after.cart",
          "before_path": "before.cart"
        }
      ]
    }
  ],
  "setup": {
    "order": {
      "sku_id": "demo:cn-pepsi-original-330ml-can"
    }
  }
}
