{
  "case_id": "R05",
  "group": "drink",
  "scenario_family": "drink-classify-filter-to-confirm",
  "split": "regression",
  "core": true,
  "goal": "饮料分类和品牌筛选后购买两罐百事",
  "basis": "docs/plans/ceres-next-agent-experience-spec.md; candidate ac895fd public API contracts and corresponding backend/tests; data/fixtures/demo-products.json + store-offers.json",
  "rubric": "完成所标注目标；保留当前约束，选择不等于加购；价格/商品/政策有来源；业务处理状态与实际回执一致；不重复已知信息；未执行步骤不能判通过。",
  "steps": [
    {
      "op": "turn",
      "label": "request",
      "message": "买点饮料，两件，预算20元",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": false
        },
        {
          "kind": "present",
          "path": "after.guide.pending_clarifications",
          "value": true
        }
      ]
    },
    {
      "op": "select_pending_option",
      "label": "choose-type",
      "slot": "product_type",
      "label_equals": "可乐",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.product_cards",
          "value": true
        },
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": false
        }
      ]
    },
    {
      "op": "select_pending_option",
      "label": "choose-brand",
      "slot": "product_filter",
      "label_equals": "品牌：百事可乐",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.product_cards",
          "value": true
        },
        {
          "kind": "fields",
          "path": "after.guide.product_cards",
          "value": {
            "brand": "百事可乐"
          }
        },
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": false
        }
      ]
    },
    {
      "op": "turn",
      "label": "selected-purchase",
      "message": "那就买两罐百事可乐原味汽水330ml罐装",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": true
        },
        {
          "kind": "quantities",
          "path": "after.guide.plan.items",
          "value": {
            "demo:cn-pepsi-original-330ml-can": 2
          }
        },
        {
          "kind": "eq",
          "path": "after.guide.plan.selected_total_fen",
          "value": 600
        },
        {
          "kind": "eq",
          "path": "after.guide.constraints_summary.budget_fen",
          "value": 2000
        }
      ]
    },
    {
      "op": "confirm_plan",
      "label": "explicit-confirm",
      "authorized": [
        "cart"
      ],
      "expect": [
        {
          "kind": "quantities",
          "path": "after.cart.items",
          "value": {
            "demo:cn-pepsi-original-330ml-can": 2
          }
        }
      ]
    }
  ]
}
