{
  "case_id": "H15",
  "group": "theme",
  "scenario_family": "theme-policy-interruption-product-identity",
  "split": "acceptance",
  "core": false,
  "goal": "成品活动商品查询后插话政策仍保留商品对象",
  "basis": "docs/plans/ceres-next-agent-experience-spec.md; candidate ac895fd public API contracts and corresponding backend/tests; data/fixtures/demo-products.json + store-offers.json",
  "rubric": "完成所标注目标；保留当前约束，选择不等于加购；价格/商品/政策有来源；业务处理状态与实际回执一致；不重复已知信息；未执行步骤不能判通过。",
  "steps": [
    {
      "op": "turn",
      "label": "price",
      "message": "这份鲜果成品拼盘多少钱？",
      "expect": [
        {
          "kind": "present",
          "path": "reply",
          "value": true
        },
        {
          "kind": "unchanged",
          "path": "after.cart",
          "before_path": "before.cart"
        },
        {
          "kind": "unchanged",
          "path": "after.orders",
          "before_path": "before.orders"
        }
      ],
      "view_context": {
        "page": "product",
        "product_id": "demo:green-reset-fruit-platter",
        "activity_id": "green_reset"
      }
    },
    {
      "op": "turn",
      "label": "policy",
      "message": "先问一般配送时间？",
      "expect": [
        {
          "kind": "contains",
          "path": "grounding_evidence",
          "value": "P-DEL-01"
        },
        {
          "kind": "unchanged",
          "path": "after.cart",
          "before_path": "before.cart"
        },
        {
          "kind": "unchanged",
          "path": "after.orders",
          "before_path": "before.orders"
        }
      ]
    },
    {
      "op": "turn",
      "label": "purchase",
      "message": "那就买刚才那份鲜果成品拼盘",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": true
        },
        {
          "kind": "quantities",
          "path": "after.guide.plan.items",
          "value": {
            "demo:green-reset-fruit-platter": 1
          }
        },
        {
          "kind": "eq",
          "path": "after.guide.plan.selected_total_fen",
          "value": 1980
        }
      ]
    }
  ],
  "entry_context": {
    "page": "activity",
    "activity_id": "green_reset",
    "store_id": "store-demo-01",
    "delivery_zone_id": "zone-default"
  }
}
