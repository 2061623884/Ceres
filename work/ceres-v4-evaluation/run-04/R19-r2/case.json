{
  "case_id": "R19",
  "group": "memory",
  "scenario_family": "explicit-save-new-session-list",
  "split": "regression",
  "core": true,
  "goal": "显式保存偏好后新会话查询仍有记录",
  "basis": "docs/plans/ceres-next-agent-experience-spec.md; candidate ac895fd public API contracts and corresponding backend/tests; data/fixtures/demo-products.json + store-offers.json",
  "rubric": "完成所标注目标；保留当前约束，选择不等于加购；价格/商品/政策有来源；业务处理状态与实际回执一致；不重复已知信息；未执行步骤不能判通过。",
  "steps": [
    {
      "op": "turn",
      "label": "request",
      "message": "请长期记住我平时喜欢百事可乐",
      "expect": [
        {
          "kind": "contains",
          "path": "after.memories.0.content",
          "value": "百事"
        },
        {
          "kind": "eq",
          "path": "after.memories.0.source",
          "value": "explicit"
        },
        {
          "kind": "eq",
          "path": "after.memories.0.expires_at",
          "value": null
        },
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": false
        }
      ]
    },
    {
      "op": "new_session",
      "label": "reopen",
      "expect": [
        {
          "kind": "present",
          "path": "after.memories",
          "value": true
        }
      ]
    },
    {
      "op": "turn",
      "label": "list",
      "message": "查询你保存的全部记忆",
      "expect": [
        {
          "kind": "contains",
          "path": "reply",
          "value": "百事"
        },
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": false
        }
      ]
    }
  ]
}
