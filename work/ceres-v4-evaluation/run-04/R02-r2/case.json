          "value": 690
        }
      ]
    },
    {
      "op": "confirm_plan",
      "label": "explicit-confirm",
      "authorized": [
        "cart"
      ],
      "expect": [
        {
          "kind": "quantities",
          "path": "after.cart.items",
          "value": {
            "demo:snack-soda-crackers-100g-box": 1
          }
        }
      ]
    }
  ]
