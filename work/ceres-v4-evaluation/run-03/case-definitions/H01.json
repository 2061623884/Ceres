{
  "case_id": "H01",
  "group": "purchase",
  "scenario_family": "independent-purchase-does-not-inherit-budget",
  "split": "acceptance",
  "core": false,
  "goal": "饮品预算后开始独立零食任务不继承旧预算",
  "basis": "docs/plans/ceres-next-agent-experience-spec.md; candidate ac895fd public API contracts and corresponding backend/tests; data/fixtures/demo-products.json + store-offers.json",
  "rubric": "完成所标注目标；保留当前约束，选择不等于加购；价格/商品/政策有来源；业务处理状态与实际回执一致；不重复已知信息；未执行步骤不能判通过。",
  "steps": [
    {
      "op": "turn",
      "label": "request",
      "message": "买一瓶可口可乐经典原味汽水500ml瓶装，预算5元",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": true
        },
        {
          "kind": "quantities",
          "path": "after.guide.plan.items",
          "value": {
            "demo:cn-coke-original-500ml-bottle": 1
          }
        },
        {
          "kind": "eq",
          "path": "after.guide.plan.selected_total_fen",
          "value": 400
        }
      ]
    },
    {
      "op": "turn",
      "label": "independent-snack",
      "message": "另开一项独立采购：买两包原味薯片70克袋装，不限制预算",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": true
        },
        {
          "kind": "quantities",
          "path": "after.guide.plan.items",
          "value": {
            "demo:snack-original-potato-chips-70g-bag": 2
          }
        },
        {
          "kind": "eq",
          "path": "after.guide.plan.selected_total_fen",
          "value": 1180
        },
        {
          "kind": "eq",
          "path": "after.guide.constraints_summary.budget_fen",
          "value": null
        }
      ]
    },
    {
      "op": "confirm_plan",
      "label": "explicit-confirm",
      "authorized": [
        "cart"
      ],
      "expect": [
        {
          "kind": "quantities",
          "path": "after.cart.items",
          "value": {
            "demo:snack-original-potato-chips-70g-bag": 2
          }
        }
      ]
    }
  ]
}
