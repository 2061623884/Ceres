{
  "case_id": "R38",
  "group": "purchase",
  "scenario_family": "price-discussion-no-authorization",
  "split": "regression",
  "core": false,
  "goal": "只接受报价不能自动加购",
  "basis": "docs/plans/ceres-next-agent-experience-spec.md; candidate ac895fd public API contracts and corresponding backend/tests; data/fixtures/demo-products.json + store-offers.json",
  "rubric": "完成所标注目标；保留当前约束，选择不等于加购；价格/商品/政策有来源；业务处理状态与实际回执一致；不重复已知信息；未执行步骤不能判通过。",
  "steps": [
    {
      "op": "turn",
      "label": "request",
      "message": "买一盒苏打饼干100克盒装",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": true
        },
        {
          "kind": "quantities",
          "path": "after.guide.plan.items",
          "value": {
            "demo:snack-soda-crackers-100g-box": 1
          }
        },
        {
          "kind": "eq",
          "path": "after.guide.plan.selected_total_fen",
          "value": 690
        }
      ]
    },
    {
      "op": "turn",
      "label": "accept-price-only",
      "message": "这个价格可以，先放清单里，不要加购",
      "expect": [
        {
          "kind": "unchanged",
          "path": "after.cart",
          "before_path": "before.cart"
        },
        {
          "kind": "unchanged",
          "path": "after.orders",
          "before_path": "before.orders"
        },
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": true
        }
      ]
    }
  ]
}
