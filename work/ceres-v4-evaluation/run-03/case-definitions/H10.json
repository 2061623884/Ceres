{
  "case_id": "H10",
  "group": "routing",
  "scenario_family": "refused-switch-then-current-shopping",
  "split": "acceptance",
  "core": false,
  "goal": "拒绝具体订单切换后仍可在可可购买水",
  "basis": "docs/plans/ceres-next-agent-experience-spec.md; candidate ac895fd public API contracts and corresponding backend/tests; data/fixtures/demo-products.json + store-offers.json",
  "rubric": "完成所标注目标；保留当前约束，选择不等于加购；价格/商品/政策有来源；业务处理状态与实际回执一致；不重复已知信息；未执行步骤不能判通过。",
  "steps": [
    {
      "op": "turn",
      "label": "request",
      "message": "订单 {{order_id}} 物流呢？",
      "expect": [
        {
          "kind": "eq",
          "path": "route.decision",
          "value": "suggest_switch"
        },
        {
          "kind": "unchanged",
          "path": "after.cart",
          "before_path": "before.cart"
        },
        {
          "kind": "unchanged",
          "path": "after.orders",
          "before_path": "before.orders"
        }
      ]
    },
    {
      "op": "switch",
      "label": "decline-momo",
      "target_role": "momo",
      "accept": false,
      "authorized": [],
      "expect": [
        {
          "kind": "eq",
          "path": "after.opening.role",
          "value": "keke"
        }
      ]
    },
    {
      "op": "turn",
      "label": "new-shopping",
      "message": "先不查订单了，买一瓶农夫山泉饮用水550ml瓶装",
      "expect": [
        {
          "kind": "present",
          "path": "after.guide.plan",
          "value": true
        },
        {
          "kind": "quantities",
          "path": "after.guide.plan.items",
          "value": {
            "demo:cn-nongfu-water-550ml-bottle": 1
          }
        },
        {
          "kind": "eq",
          "path": "after.guide.plan.selected_total_fen",
          "value": 200
        }
      ]
    },
    {
      "op": "confirm_plan",
      "label": "explicit-confirm",
      "authorized": [
        "cart"
      ],
      "expect": [
        {
          "kind": "quantities",
          "path": "after.cart.items",
          "value": {
            "demo:cn-nongfu-water-550ml-bottle": 1
          }
        }
      ]
    }
  ],
  "setup": {
    "order": {
      "sku_id": "demo:cn-pepsi-original-330ml-can"
    }
  }
}
