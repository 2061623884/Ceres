# live only — mock runtime removed
LLM_MODE=live
BUSINESS_DATA_MODE=demo
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=1536
SEMANTIC_MAX_STEPS=2
SEMANTIC_LOOKUP_BUDGET=2
SOURCE_DATABASE_PATH=data/sale_guide.db
DATABASE_URL=sqlite:///data/runtime/sale_guide.sqlite3
# Retrieval: hybrid | lexical. Deployment/offline-comparison switch only; the
# model never changes it. The index is built offline and never written at request time.
RETRIEVAL_MODE=hybrid
RETRIEVAL_INDEX_DIR=data/retrieval_index
# Embedding is a separate endpoint contract from chat (own model/dimension/instruction).
# Leave blank to run lexical-only; the vector route then reports a real fallback reason.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_REVISION=
EMBEDDING_DIMENSION=1024
EMBEDDING_QUERY_INSTRUCTION=
EMBEDDING_DOCUMENT_INSTRUCTION=
EMBEDDING_TIMEOUT=30
BACKEND_PORT=8000
FRONTEND_PORT=3000
INTERNAL_ENABLED=false
INTERNAL_ADMIN_TOKEN=
TRACE_RETENTION_DAYS=7
